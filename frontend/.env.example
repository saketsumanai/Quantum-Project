# ==============================================================================
# Frontend Environment Variables — Quantum Leap (Vite / React)
# Copy this file to .env (frontend/.env) and fill in your project values.
# NEVER commit the filled-in .env to version control.
# ==============================================================================

# ── Firebase (Client SDK) ──────────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → General → Your Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Backend API URL ────────────────────────────────────────────────────────────
# Leave empty for local dev (auto-uses http://localhost:8000)
# Set to your deployed backend URL in production (e.g. https://api.yourdomain.com)
VITE_API_URL=
