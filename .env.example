# ==============================================================================
# Quantum Leap — Environment Configuration (SIH 2026)
# Copy to .env before starting. NEVER commit .env to git!
# ==============================================================================

# --- Application Core ---
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (SQLite default, swap for PostgreSQL in prod) ---
DATABASE_URL=sqlite:///./quantum_leap.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quantum_leap_db

# --- Firebase Admin SDK (Backend — for verifying Google ID tokens) ---
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# --- Quantum Simulation Engine ---
DEFAULT_QUANTUM_BACKEND=qiskit
DEFAULT_SHOT_COUNT=1024
MAX_SHOT_COUNT=8192
MAX_QUBIT_COUNT=16
EXECUTION_TIMEOUT_SECONDS=10

# --- AI Tutor & RAG (ChromaDB + LLM) ---
# Primary LLM: Groq Llama-3.1 (free, fastest)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=

# Fallback LLM: Google Gemini 1.5 Flash (free tier)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: OpenAI
OPENAI_API_KEY=

# Embedding model (local CPU, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_PATH=./data/vector_store

# --- Demo / Offline Safety ---
ENABLE_FAILSAFE_CACHE=true
SIMULATION_CACHE_DIR=./data/cached_simulations

# --- Quantum Cloud & Hardware Providers ---
IBM_QUANTUM_API_KEY=your_ibm_quantum_api_key_here
BLUEQUBIT_API_KEY=your_bluequbit_api_key_here

