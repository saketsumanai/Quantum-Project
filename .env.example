# ==============================================================================
# Quantum Project - SIH 2026 Environment Configuration
# Copy this file to .env before starting the development environment.
# DO NOT commit .env with real credentials to source control!
# ==============================================================================

# --- Application Core ---
ENVIRONMENT=development                # development | production | test
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # 24 hours

# --- Database Configuration ---
# Default to zero-setup SQLite for rapid local hackathon development
DATABASE_URL=sqlite:///./quantum_platform.db
# Production PostgreSQL (Supabase / Neon / Local Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quantum_db

# --- Quantum Simulation Engine ---
DEFAULT_QUANTUM_BACKEND=qiskit         # qiskit | pennylane | cirq
DEFAULT_SHOT_COUNT=1024
MAX_SHOT_COUNT=8192
MAX_QUBIT_COUNT=16                     # Safety cap for local browser/CPU simulation
EXECUTION_TIMEOUT_SECONDS=10           # Hard cutoff to prevent Denial of Service

# --- AI Tutor & RAG Intelligence ---
# For SIH live demo, pick one provider. The system automatically falls back to offline cache if empty or unreachable.
LLM_PROVIDER=offline_fallback          # gemini | groq | openai | offline_fallback
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2       # Lightweight local CPU sentence-transformer
VECTOR_DB_PATH=./data/vector_store

# --- SIH Offline / Failsafe Demo Mode ---
ENABLE_FAILSAFE_CACHE=true             # When true, serves pre-verified deterministic states if API is unreachable
SIMULATION_CACHE_DIR=./data/cached_simulations
